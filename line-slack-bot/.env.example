# --- サーバー ---
PORT=3000

# --- データベース (デフォルトはSQLite。本番はPostgresを推奨) ---
DATABASE_URL="file:./dev.db"

# --- LINE Messaging API ---
# LINE Developers コンソール > チャネル基本設定 で取得
LINE_CHANNEL_SECRET=
# LINE Developers コンソール > Messaging API設定 で発行
LINE_CHANNEL_ACCESS_TOKEN=

# --- Slack App ---
# Slack App管理画面 > OAuth & Permissions で取得 (xoxb-...)
SLACK_BOT_TOKEN=
# Slack App管理画面 > Basic Information > App Credentials
SLACK_SIGNING_SECRET=
# 返信候補を投稿するチャンネルID (例: C0123456789)
SLACK_CHANNEL_ID=

# --- Claude API ---
# https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY=
# 返信文生成に使うモデル
ANTHROPIC_MODEL=claude-sonnet-5

# 1件の受信メッセージにつき生成する返信候補の数
REPLY_CANDIDATE_COUNT=3
